if root is None:
  return []
q=deque()
q.append(root)
ans=[]
while q:
  level=[]
  n=len(q)
  for i in range(n):
      front=q.popleft()
      level.append(front.val)
      if front.left!=None:
          q.append(front.left)
      if front.right!=None:
          q.append(front.right)
  ans.append(level[-1])
return ans
