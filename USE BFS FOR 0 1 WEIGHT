class Solution:
    def countOfPairs(self, n: int, x: int, y: int) -> List[int]:
        mp=defaultdict(int)
        adj=defaultdict(list)
        for i in range(1,n):
            adj[i].append(i+1)
            adj[i+1].append(i)
        if x!=y:
            adj[x].append(y)
            adj[y].append(x)

        for i in range(1,n+1):
            q=deque()
            dist=0
            q.append(i)
            visited=set()
            visited.add(i)
            while q:
                lvl=len(q)
                dist+=1
                for pt in range(lvl):
                    node=q.popleft()
                    for nd in adj[node]:
                        if nd not in visited:
                            q.append(nd)
                            visited.add(nd)
                            mp[dist]+=1
        ans=[]
        for k in range(1,n+1):
            ans.append(mp[k])
        return ans








            
            
            

            
        
